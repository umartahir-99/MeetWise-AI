# Copy to .env.local (git-ignored) and fill in from your Supabase dashboard:
# Project Settings -> API
#
# Both of these are safe to ship in the browser bundle. RLS is what actually
# protects the data, not the secrecy of these values (TRD 7, "Secrets").
#
# The two are NOT the same string. The ref identifies the project and appears
# in the URL; the anon key is a long token that authenticates the request.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<the anon / publishable key from the same page>
